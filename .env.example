# Sentinel configuration. Copy to .env (make setup does this) and fill in.
# Values set in the real environment override this file.

# --- Server ---
# Go API port
PORT=8080
# Timezone for cron triggers (IANA name)
TIMEZONE=Asia/Kolkata
# Dashboard origin allowed by CORS
CORS_ORIGIN=http://localhost:3000
# Base URL used for links in notifications
DASHBOARD_URL=http://localhost:3000
# true disables all mutating endpoints (public demo deployments)
DEMO_READ_ONLY=false

# --- Paths (relative paths are resolved against server/) ---
# SQLite DB and run/agent artifacts
DATA_DIR=../data
# Agents and Playwright project
AGENTS_DIR=../agents

# --- Timeouts ---
# Max duration of one test run
RUN_TIMEOUT=15m
# How long a run waits for triage
TRIAGE_TIMEOUT=3m

# --- LLM ---
# gemini or anthropic
LLM_PROVIDER=gemini
# Model name for the provider (required for agents)
LLM_MODEL=
# Send screenshots to the model
LLM_VISION=true
# Provider keys: never commit real values
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Agent budgets ---
# Step budget per agent run
AGENT_MAX_STEPS=80
# Cost budget per agent run, in USD
AGENT_MAX_COST_USD=1.00
# Wall-clock budget per agent run
AGENT_TIMEOUT=20m
# Agent runs at the same time (others queue)
AGENT_CONCURRENCY=1

# --- Notifications ---
# Slack Incoming Webhook URL (leave empty to disable)
SLACK_WEBHOOK_URL=
# Email reports over SMTP (leave EMAIL_TO empty to disable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
